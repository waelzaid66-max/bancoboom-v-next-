{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/preinstall-enforce-pnpm.mjs",
    "setup": "node scripts/setup-local-env.mjs && pnpm install",
    "dev": "pnpm --filter @workspace/api-server --filter @workspace/banco-web --filter @workspace/banco-website --parallel run dev",
    "dev:mobile": "pnpm --filter @workspace/banco-mobile run dev",
    "start": "docker compose -f docker-compose.prod.yml up -d --build",
    "stop": "docker compose -f docker-compose.prod.yml down",
    "logs": "docker compose -f docker-compose.prod.yml logs -f",
    "prebuild": "pnpm run workspace:verify",
    "build": "pnpm run typecheck && pnpm -r --workspace-concurrency=1 --if-present run build",
    "build:mobile": "pnpm run mobile:verify",
    "mobile:preflight": "node scripts/mobile-release-preflight.mjs",
    "mobile:verify": "pnpm run mobile:preflight && pnpm --filter @workspace/banco-mobile run typecheck && pnpm --filter @workspace/banco-mobile run test && pnpm --filter @workspace/banco-mobile run build",
    "mobile:eas": "bash scripts/eas-build.sh",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "typecheck:website": "pnpm --filter @workspace/design-tokens run typecheck && pnpm --filter @workspace/search-contract run typecheck && pnpm --filter @workspace/landing run typecheck && pnpm --filter @workspace/banco-web run typecheck && pnpm --filter @workspace/banco-website run typecheck",
    "lint": "eslint scripts --max-warnings 0",
    "lint:website": "eslint artifacts/banco-web artifacts/banco-website artifacts/landing --max-warnings 0",
    "lint:workspaces": "eslint artifacts/admin-os artifacts/dealer-os artifacts/banco-mobile artifacts/mockup-sandbox",
    "lint:all": "pnpm run lint && pnpm run lint:website && pnpm run lint:workspaces",
    "lint:report": "eslint scripts artifacts/api-server/src lib/db/src",
    "test:api-test-db-safety": "node --test scripts/run-api-tests-local.safety.test.mjs",
    "ops:website-ci": "node scripts/website-ci-local.mjs",
    "ops:website-staging-prep": "node scripts/website-staging-prep-audit.mjs",
    "ops:website-staging-smoke": "node scripts/website-staging-smoke.mjs",
    "ops:website-soft-launch-prep": "node scripts/website-soft-launch-prep-audit.mjs",
    "ops:live-cutover": "node scripts/ops-live-cutover-check.mjs",
    "confidence": "node scripts/production-confidence-check.mjs",
    "security:audit": "node scripts/dependency-security-gate.mjs",
    "workspace:verify": "node scripts/workspace-verify.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^14.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {}
}

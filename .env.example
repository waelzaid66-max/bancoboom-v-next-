# BANCO Store — environment variable NAMES only (no secrets).
# Copy the platform-specific template and fill values in your secret store.
#
# Replit: use the encrypted secret store + public keys in .replit (see replit.md).
# Coolify: docker-compose.coolify.yml + COOLIFY_DEPLOY_NOW.md + OPS_GO_LIVE_CHECKLIST.md
# AWS:    deploy/aws/env/.env.production.example
# GCP:    deploy/gcp/env/.env.production.example
# Staging smoke checklist: audit/production-readiness/STAGING-REQUIRED-SECRETS.md
# Mobile EAS: release/EAS_BUILD.md (dashboard env = production)
#
# ★ Post-merge operator path: OPS_GO_LIVE_CHECKLIST.md (tick boxes in order)
# Coolify compose REQUIRED (API refuses start without these):
#   POSTGRES_PASSWORD CLERK_SECRET_KEY SESSION_SECRET PAYMENT_CONFIG_ENCRYPTION_KEY
# Coolify object storage (VPS — no IAM role):
#   OBJECT_STORAGE_PROVIDER=s3 AWS_REGION S3_BUCKET AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
#   PUBLIC_OBJECT_SEARCH_PATHS PRIVATE_OBJECT_DIR
# Coolify recommended:
#   CORS_ALLOWED_ORIGINS PUBLIC_API_BASE_URL PUBLIC_APP_URL GIT_SHA BUILD_ID
#   BANCO_WEB_URL BANCO_WEBSITE_URL NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY VITE_CLERK_PUBLISHABLE_KEY
#   BANCO_WEB_MARKET_URL=/market/ BANCO_WEB_ADMIN_URL=/admin/
# Core (API will not boot without PORT + DATABASE_URL — compose builds DATABASE_URL):
#   PORT DATABASE_URL SESSION_SECRET PAYMENT_CONFIG_ENCRYPTION_KEY
# Auth:
#   CLERK_SECRET_KEY CLERK_PUBLISHABLE_KEY
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (web)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (mobile)
#   EXPO_PUBLIC_CLERK_PROXY_URL (optional custom-domain proxy)
# DB pool (multi-replica Coolify — keep total replicas × DB_POOL_MAX under Postgres max_connections):
#   DB_POOL_MAX=20 DB_POOL_IDLE_MS=30000 DB_POOL_CONNECT_MS=10000
# CDN (optional — unset keeps apps byte-identical; set to move hashed static to edge):
#   NEXT_PUBLIC_ASSET_CDN_URL
# Optional features:
#   RESEND_API_KEY OPENAI_API_KEY OPENAI_MODEL OPENAI_TIMEOUT_MS OPENAI_MAX_RETRIES
#   OPENAI_MAX_COMPLETION_TOKENS ERROR_ALERT_WEBHOOK PAYMOB_* OBJECT_STORAGE_*
# Mobile / EAS (public, baked at build — set in EAS dashboard production env):
#   EXPO_PUBLIC_DOMAIN (or EXPO_PUBLIC_API_BASE_URL)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY
#   EXPO_PUBLIC_PUBLIC_APP_URL EXPO_PUBLIC_ROUTER_ORIGIN
#
# NEVER commit .env files with real values.

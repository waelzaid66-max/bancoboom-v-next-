# BANCO Admin OS — Control Center
# All values are baked at build time (Vite) or injected by nginx BASE_URL at runtime.
# On Coolify: set these in the service environment and rebuild.
# On Replit dev: the Replit artifact runner injects PORT automatically.

# Clerk (required — must match the API server's Clerk tenant)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: Clerk Proxy (required for custom domain Clerk proxy setup)
# VITE_CLERK_PROXY_URL=https://banco.today/clerk-proxy

# API base path — admin-os calls /api/v1/* relative to its origin.
# On Coolify nginx, /api/* is proxied to the API server automatically.
# On Replit dev with separate ports, you may need to proxy manually.
# VITE_API_BASE_URL=http://localhost:8080
